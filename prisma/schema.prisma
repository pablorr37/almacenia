// Derivado 1:1 de specs/sdd/*.md (fuente de verdad del modelo de datos). Cualquier
// cambio de modelo se hace primero en la spec correspondiente, no directo acá.
// Ver specs/sdd/00-overview.md para las convenciones generales.
//
// Los CHECK constraints documentados en cada spec (precio_no_negativo,
// stock_no_negativo, cantidad_positiva, total_no_negativo,
// pedido_id_solo_si_origen_pedido, precio_oferta_no_negativo, precio_oferta_menor,
// puntuacion_valida, ...) no se pueden declarar en este DSL — se agregan a mano en
// la migración SQL generada (ver prisma/migrations/, comentario ahí). El índice
// GIST de Tienda.ubicacion sí está declarado acá (@@index type: Gist), así el diff
// de Prisma no lo vuelve a borrar en cada migración nueva.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated-prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// ---------------------------------------------------------------------------
// 01-auth.md
// ---------------------------------------------------------------------------

// 01-auth.md, "Estado de la cuenta".
enum EstadoCuenta {
  activa
  pausada
  baneada

  @@map("estado_cuenta")
}

model Usuario {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  nombre       String
  esComprador  Boolean  @default(true) @map("es_comprador")
  esVendedor   Boolean  @default(false) @map("es_vendedor")
  esAdmin      Boolean  @default(false) @map("es_admin")
  esTester     Boolean  @default(false) @map("es_tester")
  estadoCuenta     EstadoCuenta @default(activa) @map("estado_cuenta")
  motivoSuspension String?      @map("motivo_suspension")
  suspendidaEn     DateTime?    @map("suspendida_en")
  plan             Plan         @default(free) // 18-alcance.md
  // 23-puntos-pagos.md: null = sin vencimiento (asignado por el admin).
  planVenceEn      DateTime?      @map("plan_vence_en")
  renovacionAuto   RenovacionAuto @default(ninguna) @map("renovacion_auto")
  avatarUrl    String?  @map("avatar_url")
  creadoEn     DateTime @default(now()) @map("creado_en")

  tiendas       Tienda[]
  membresias    MiembroTienda[]
  pedidos       Pedido[]
  ventas        Venta[]        @relation("VentasComprador")
  ventasRegistradas Venta[]    @relation("VentasRegistradas")
  resenas       Resena[]
  eventosPuntos EventoPuntos[] @relation("EventosDelUsuario")

  valoracionesRecibidas  ValoracionCliente[]
  eventosComoContraparte EventoPuntos[]        @relation("EventosContraparte")
  checkIns               CheckInTienda[]
  visitasPagina          VisitaPaginaTienda[]
  listasCompras          ListaCompras[]
  fotosSubidas           FotoBanco[]           @relation("FotosSubidas")
  fotosRevisadas         FotoBanco[]           @relation("FotosRevisadas")
  codigosCliente         CodigoCliente[]
  catalogoCargado        ProductoCatalogo[]    @relation("CatalogoCargado")
  categoriasCreadas      CategoriaProducto[]   @relation("CategoriasCreadas")
  ordenesPago            OrdenPago[]           @relation("OrdenesDelUsuario")
  ordenesConfirmadas     OrdenPago[]           @relation("OrdenesConfirmadas")
  campaniasCreadas       CampaniaAviso[]
  eventosAviso           EventoAviso[]
  notificaciones         Notificacion[]
  suscripcionesPush      SuscripcionPush[]
  preferenciasNotif      PreferenciaNotificacion[]
  enviosCreados          EnvioNotificacion[]

  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// 02-tiendas.md
// ---------------------------------------------------------------------------

model Tienda {
  id             String    @id @default(uuid())
  vendedorId     String    @map("vendedor_id") // propietario (19-equipo-tienda.md)
  nombre         String
  descripcion    String?
  direccion      String
  // PostGIS no tiene tipo nativo en Prisma: se declara Unsupported y se accede vía
  // $queryRaw para operaciones espaciales (ST_DWithin, ST_Distance, etc.). El índice
  // GIST está declarado abajo (@@index ... type: Gist).
  ubicacion      Unsupported("geography(Point, 4326)")
  activa         Boolean   @default(true)
  desactivadaEn  DateTime? @map("desactivada_en")
  imagenUrl      String?   @map("imagen_url")
  rubroId        String?   @map("rubro_id")
  verificada     Boolean   @default(false)
  plan           Plan      @default(free)
  mediosDePago   MedioPago[] @default([]) @map("medios_de_pago")
  abierto24hs    Boolean   @default(false) @map("abierto_24hs")
  // 12-gamificacion.md: % de los puntos de una venta para el miembro que la registró.
  // null = default del sistema (gamificacion.porcentaje_puntos_equipo).
  porcentajePuntosEquipo Int? @map("porcentaje_puntos_equipo") @db.SmallInt
  // Datos fiscales (20-precios-facturacion.md); los edita solo el propietario.
  condicionIva      CondicionIva @default(monotributo) @map("condicion_iva")
  razonSocial       String?      @map("razon_social")
  cuit              String?      @db.Char(11)
  ingresosBrutos    String?      @map("ingresos_brutos")
  domicilioFiscal   String?      @map("domicilio_fiscal")
  puntoVenta        Int?         @map("punto_venta")
  inicioActividades DateTime?    @map("inicio_actividades") @db.Date
  creadaEn       DateTime  @default(now()) @map("creada_en")
  actualizadaEn  DateTime  @default(now()) @updatedAt @map("actualizada_en")

  vendedor               Usuario                 @relation(fields: [vendedorId], references: [id])
  rubro                  Rubro?                  @relation(fields: [rubroId], references: [id])
  productos              Producto[]
  pedidos                Pedido[]
  ventas                 Venta[]
  horarios               HorarioTienda[]
  resenas                Resena[]
  solicitudesVerificacion SolicitudVerificacion[]
  valoracionesClientes    ValoracionCliente[]
  eventosPuntos           EventoPuntos[]
  checkIns                CheckInTienda[]
  visitasPagina           VisitaPaginaTienda[]
  miembros                MiembroTienda[]
  comprobantes            Comprobante[]
  numeraciones            NumeracionComprobante[]
  campanias               CampaniaAviso[]
  notificaciones          Notificacion[]

  @@index([vendedorId])
  @@index([ubicacion], map: "tiendas_ubicacion_gist_idx", type: Gist)
  @@map("tiendas")
}

enum MedioPago {
  efectivo
  transferencia
  mercado_pago
  debito
  qr

  @@map("medio_pago")
}

// ---------------------------------------------------------------------------
// 17-rubros-categorias.md — listas que mantiene el admin
// ---------------------------------------------------------------------------

model Rubro {
  id                String   @id @default(uuid())
  nombre            String
  nombreNormalizado String   @unique @map("nombre_normalizado")
  orden             Int      @default(0)
  creadoEn          DateTime @default(now()) @map("creado_en")

  tiendas Tienda[]

  @@map("rubros")
}

model CategoriaProducto {
  id                String   @id @default(uuid())
  nombre            String
  nombreNormalizado String   @unique @map("nombre_normalizado")
  creadaEn          DateTime @default(now()) @map("creada_en")
  // Quién la creó: null = admin o migración; si no, un usuario premium o mayor
  // (17-rubros-categorias.md).
  creadaPorId       String?  @map("creada_por_id")

  creadaPor        Usuario?           @relation("CategoriasCreadas", fields: [creadaPorId], references: [id], onDelete: SetNull)
  entradasCatalogo ProductoCatalogo[]
  productos        Producto[]

  @@map("categorias_producto")
}

enum Plan {
  free
  premium
  plata

  @@map("plan")
}

enum EstadoVerificacion {
  pendiente
  aprobada
  rechazada

  @@map("estado_verificacion")
}

model SolicitudVerificacion {
  id           String             @id @default(uuid())
  tiendaId     String             @map("tienda_id")
  estado       EstadoVerificacion @default(pendiente)
  creadaEn     DateTime           @default(now()) @map("creada_en")
  revisadaEn   DateTime?          @map("revisada_en")
  revisadaPor  String?            @map("revisada_por")
  notaAdmin    String?            @map("nota_admin")

  tienda Tienda @relation(fields: [tiendaId], references: [id])

  @@index([tiendaId])
  @@map("solicitudes_verificacion")
}

model HorarioTienda {
  id        String  @id @default(uuid())
  tiendaId  String  @map("tienda_id")
  diaSemana Int     @map("dia_semana") // 0=domingo .. 6=sábado
  abre      String? // "HH:mm", null si cerrado ese día
  cierra    String? // "HH:mm", null si cerrado ese día

  tienda Tienda @relation(fields: [tiendaId], references: [id])

  // Una fila por franja: un día puede tener varias (horario partido).
  @@index([tiendaId, diaSemana])
  @@map("horarios_tienda")
}

// ---------------------------------------------------------------------------
// 06-catalogo.md
// ---------------------------------------------------------------------------

model ProductoCatalogo {
  id           String    @id @default(uuid())
  nombre       String
  descripcion  String?
  marca        String?
  categoriaId  String    @map("categoria_id")
  variante     String?
  contenido    Decimal?  @db.Decimal(10, 3)
  unidadContenido UnidadContenido? @map("unidad_contenido")
  codigoBarras String?   @unique @map("codigo_barras")
  imagenUrl    String?   @map("imagen_url")
  unidad       UnidadMedida @default(unidad)
  creadoEn     DateTime  @default(now()) @map("creado_en")
  // Si lo cargó un comprador desde su lista (14-listas-compras.md); null si vino de una tienda o del seed.
  creadoPorId  String?   @map("creado_por_id")

  creadoPor   Usuario?   @relation("CatalogoCargado", fields: [creadoPorId], references: [id], onDelete: SetNull)
  categoria   CategoriaProducto @relation(fields: [categoriaId], references: [id])
  productos   Producto[]
  itemsListas ItemListaCompras[]

  @@index([nombre])
  @@index([categoriaId])
  @@index([creadoPorId, creadoEn])
  @@map("productos_catalogo")
}

// Cómo se vende un producto (03-productos.md, "Cantidades y unidades").
enum UnidadMedida {
  unidad
  kg

  @@map("unidad_medida")
}

// Unidad del contenido del envase (06-catalogo.md): "1 kg", "500 g", "1,5 l", "6 u".
enum UnidadContenido {
  g
  kg
  ml
  l
  u

  @@map("unidad_contenido")
}

// ---------------------------------------------------------------------------
// 03-productos.md
// ---------------------------------------------------------------------------

model Producto {
  id            String   @id @default(uuid())
  tiendaId      String   @map("tienda_id")
  catalogoId    String   @map("catalogo_id")
  nombre        String
  descripcion   String?
  categoriaId   String?  @map("categoria_id")
  imagenUrl     String?  @map("imagen_url")
  precio        Decimal  @db.Decimal(12, 2)
  precioOferta  Decimal? @map("precio_oferta") @db.Decimal(12, 2)
  // 20-precios-facturacion.md: precio = costo + ganancia + impuestos.
  costo             Decimal?    @db.Decimal(12, 2)
  margen            Decimal?    @db.Decimal(7, 2)
  alicuotaIva       AlicuotaIva @default(iva_21) @map("alicuota_iva")
  impuestosInternos Decimal     @default(0) @map("impuestos_internos") @db.Decimal(5, 2)
  destacado     Boolean  @default(false)
  stock         Decimal  @default(0) @db.Decimal(10, 3)
  disponible    Boolean  @default(true)
  // 03-productos.md: baja del producto (sigue la fila por el historial de ventas).
  eliminadoEn   DateTime? @map("eliminado_en")
  favorito      Boolean  @default(false)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en")

  tienda      Tienda             @relation(fields: [tiendaId], references: [id])
  catalogo    ProductoCatalogo   @relation(fields: [catalogoId], references: [id])
  categoria   CategoriaProducto? @relation(fields: [categoriaId], references: [id])
  itemsPedido ItemPedido[]
  itemsVenta  ItemVenta[]
  resenas     Resena[]

  @@index([tiendaId, eliminadoEn])
  @@index([catalogoId])
  @@index([categoriaId])
  @@index([catalogoId, disponible])
  @@map("productos")
}

// ---------------------------------------------------------------------------
// 07-resenas.md
// ---------------------------------------------------------------------------

model Resena {
  id          String   @id @default(uuid())
  compradorId String   @map("comprador_id")
  tiendaId    String   @map("tienda_id")
  productoId  String?  @map("producto_id")
  puntuacion  Int
  comentario  String?
  creadaEn    DateTime @default(now()) @map("creada_en")

  comprador Usuario   @relation(fields: [compradorId], references: [id])
  tienda    Tienda    @relation(fields: [tiendaId], references: [id])
  producto  Producto? @relation(fields: [productoId], references: [id])

  @@unique([compradorId, productoId])
  @@index([tiendaId])
  @@index([productoId])
  @@map("resenas")
}

// ---------------------------------------------------------------------------
// 13-valoraciones-clientes.md
// ---------------------------------------------------------------------------

model ValoracionCliente {
  id            String   @id @default(uuid())
  tiendaId      String   @map("tienda_id")
  compradorId   String   @map("comprador_id")
  puntuacion    Int      @db.SmallInt
  comentario    String?
  creadaEn      DateTime @default(now()) @map("creada_en")
  actualizadaEn DateTime @default(now()) @updatedAt @map("actualizada_en")

  tienda    Tienda  @relation(fields: [tiendaId], references: [id])
  comprador Usuario @relation(fields: [compradorId], references: [id])

  @@unique([tiendaId, compradorId])
  @@index([compradorId])
  @@map("valoraciones_clientes")
}

// ---------------------------------------------------------------------------
// 04-pedidos.md
// ---------------------------------------------------------------------------

enum EstadoPedido {
  pendiente
  confirmado
  listo_para_retirar
  entregado
  rechazado
  cancelado

  @@map("estado_pedido")
}

model Pedido {
  id            String       @id @default(uuid())
  tiendaId      String       @map("tienda_id")
  compradorId   String       @map("comprador_id")
  estado        EstadoPedido @default(pendiente)
  nota          String?
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @default(now()) @updatedAt @map("actualizado_en")

  tienda    Tienda       @relation(fields: [tiendaId], references: [id])
  comprador Usuario      @relation(fields: [compradorId], references: [id])
  items     ItemPedido[]
  venta     Venta?

  @@index([tiendaId])
  @@index([compradorId])
  @@map("pedidos")
}

model ItemPedido {
  id             String  @id @default(uuid())
  pedidoId       String  @map("pedido_id")
  productoId     String  @map("producto_id")
  cantidad       Decimal @db.Decimal(10, 3)
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([pedidoId])
  @@map("items_pedido")
}

// ---------------------------------------------------------------------------
// 05-ventas.md
// ---------------------------------------------------------------------------

enum OrigenVenta {
  presencial
  pedido

  @@map("origen_venta")
}

// 05-ventas.md, "Máquina de estados de cobro".
enum EstadoVenta {
  por_cobrar
  cobrada
  anulada

  @@map("estado_venta")
}

// 19-equipo-tienda.md: encargados y empleados de una tienda, con sus permisos.
model MiembroTienda {
  tiendaId  String          @map("tienda_id")
  usuarioId String          @map("usuario_id")
  rol       RolMiembro
  permisos  PermisoTienda[] @default([])
  creadoEn  DateTime        @default(now()) @map("creado_en")

  tienda  Tienda  @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([tiendaId, usuarioId])
  @@index([usuarioId])
  @@map("miembros_tienda")
}

enum RolMiembro {
  encargado
  empleado

  @@map("rol_miembro")
}

enum PermisoTienda {
  vender
  cobrar
  anular
  precios
  stock
  productos
  fotos
  pedidos
  balance
  usuarios
  publicidad

  @@map("permiso_tienda")
}

// 20-precios-facturacion.md
enum CondicionIva {
  monotributo
  responsable_inscripto
  exento

  @@map("condicion_iva")
}

enum AlicuotaIva {
  iva_21
  iva_10_5
  iva_27
  iva_0
  exento

  @@map("alicuota_iva")
}

enum TipoComprobante {
  A
  B
  C

  @@map("tipo_comprobante")
}

enum EstadoComprobante {
  interno
  autorizado
  rechazado

  @@map("estado_comprobante")
}

model Comprobante {
  id               String            @id @default(uuid())
  ventaId          String            @unique @map("venta_id")
  tiendaId         String            @map("tienda_id")
  tipo             TipoComprobante
  puntoVenta       Int               @map("punto_venta")
  numero           Int
  clienteDocTipo   String            @map("cliente_doc_tipo")
  clienteDoc       String?           @map("cliente_doc")
  clienteNombre    String?           @map("cliente_nombre")
  clienteCondicion CondicionIva?     @map("cliente_condicion")
  neto             Decimal           @db.Decimal(12, 2)
  ivaPorAlicuota   Json              @map("iva_por_alicuota")
  internos         Decimal           @db.Decimal(12, 2)
  total            Decimal           @db.Decimal(12, 2)
  estado           EstadoComprobante @default(interno)
  cae              String?
  caeVencimiento   DateTime?         @map("cae_vencimiento") @db.Date
  emitidoEn        DateTime          @default(now()) @map("emitido_en")

  venta  Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  tienda Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([tiendaId, puntoVenta, tipo, numero])
  @@map("comprobantes")
}

model NumeracionComprobante {
  tiendaId   String          @map("tienda_id")
  puntoVenta Int             @map("punto_venta")
  tipo       TipoComprobante
  ultimo     Int

  tienda Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@id([tiendaId, puntoVenta, tipo])
  @@map("numeracion_comprobantes")
}

model Venta {
  id          String      @id @default(uuid())
  tiendaId    String      @map("tienda_id")
  compradorId String?     @map("comprador_id")
  pedidoId    String?     @unique @map("pedido_id")
  origen      OrigenVenta
  total       Decimal     @db.Decimal(12, 2)
  estado      EstadoVenta @default(cobrada)
  medioPago   MedioPago?  @map("medio_pago")
  nota        String?
  creadaEn    DateTime    @default(now()) @map("creada_en")
  cobradaEn   DateTime?   @map("cobrada_en")
  anuladaEn   DateTime?   @map("anulada_en")
  vendidaPorId String?    @map("vendida_por_id") // 19-equipo-tienda.md

  tienda    Tienda      @relation(fields: [tiendaId], references: [id])
  comprador Usuario?    @relation("VentasComprador", fields: [compradorId], references: [id])
  vendidaPor Usuario?   @relation("VentasRegistradas", fields: [vendidaPorId], references: [id], onDelete: SetNull)
  pedido    Pedido?     @relation(fields: [pedidoId], references: [id])
  items     ItemVenta[]
  comprobante Comprobante?

  @@index([tiendaId])
  @@index([creadaEn])
  @@index([tiendaId, estado])
  @@map("ventas")
}

model ItemVenta {
  id             String  @id @default(uuid())
  ventaId        String  @map("venta_id")
  productoId     String  @map("producto_id")
  cantidad       Decimal @db.Decimal(10, 3)
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  // Foto fiscal al vender (20-precios-facturacion.md); null en ventas anteriores.
  costoUnitario    Decimal?     @map("costo_unitario") @db.Decimal(12, 2)
  alicuotaIva      AlicuotaIva? @map("alicuota_iva")
  netoUnitario     Decimal?     @map("neto_unitario") @db.Decimal(12, 4)
  ivaUnitario      Decimal?     @map("iva_unitario") @db.Decimal(12, 4)
  internosUnitario Decimal?     @map("internos_unitario") @db.Decimal(12, 4)

  venta    Venta    @relation(fields: [ventaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([ventaId])
  @@map("items_venta")
}

// ---------------------------------------------------------------------------
// 12-gamificacion.md
// ---------------------------------------------------------------------------
// onDelete Cascade/SetNull: los puntos son un derivado de otras entidades; borrar un
// usuario/tienda (en la práctica solo pasa en tests y limpieza) no debe trabarse
// por su historial de puntos.

model EventoPuntos {
  id                   String   @id @default(uuid())
  usuarioId            String   @map("usuario_id")
  tipo                 String
  puntos               Decimal  @db.Decimal(6, 1)
  tiendaId             String?  @map("tienda_id")
  contraparteUsuarioId String?  @map("contraparte_usuario_id")
  claveUnica           String?  @unique @map("clave_unica")
  metadata             Json?
  creadoEn             DateTime @default(now()) @map("creado_en")

  usuario     Usuario  @relation("EventosDelUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  tienda      Tienda?  @relation(fields: [tiendaId], references: [id], onDelete: SetNull)
  contraparte Usuario? @relation("EventosContraparte", fields: [contraparteUsuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@map("eventos_puntos")
}

model VisitaPaginaTienda {
  compradorId String  @map("comprador_id")
  tiendaId    String  @map("tienda_id")
  ultimoMes   String  @map("ultimo_mes") // "YYYY-MM"
  ultimoValor Decimal @map("ultimo_valor") @db.Decimal(3, 1)

  comprador Usuario @relation(fields: [compradorId], references: [id], onDelete: Cascade)
  tienda    Tienda  @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@id([compradorId, tiendaId])
  @@map("visitas_pagina_tienda")
}

// 02-tiendas.md — check-in GPS
model CheckInTienda {
  id          String   @id @default(uuid())
  compradorId String   @map("comprador_id")
  tiendaId    String   @map("tienda_id")
  distanciaM  Decimal  @map("distancia_m") @db.Decimal(8, 1)
  creadoEn    DateTime @default(now()) @map("creado_en")

  comprador Usuario @relation(fields: [compradorId], references: [id], onDelete: Cascade)
  tienda    Tienda  @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([compradorId, tiendaId, creadoEn])
  @@map("checkins_tienda")
}

// ---------------------------------------------------------------------------
// 11-admin.md — configuración del sistema
// ---------------------------------------------------------------------------

model ConfiguracionSistema {
  clave         String   @id
  valor         Json
  actualizadaEn DateTime @default(now()) @updatedAt @map("actualizada_en")

  @@map("configuracion_sistema")
}

// ---------------------------------------------------------------------------
// 14-listas-compras.md
// ---------------------------------------------------------------------------

model ListaCompras {
  id            String   @id @default(uuid())
  compradorId   String   @map("comprador_id")
  nombre        String
  creadaEn      DateTime @default(now()) @map("creada_en")
  actualizadaEn DateTime @default(now()) @updatedAt @map("actualizada_en")

  comprador Usuario            @relation(fields: [compradorId], references: [id], onDelete: Cascade)
  items     ItemListaCompras[]

  @@index([compradorId])
  @@map("listas_compras")
}

model ItemListaCompras {
  id         String @id @default(uuid())
  listaId    String @map("lista_id")
  catalogoId String @map("catalogo_id")
  cantidad   Decimal @db.Decimal(10, 3)

  lista    ListaCompras     @relation(fields: [listaId], references: [id], onDelete: Cascade)
  catalogo ProductoCatalogo @relation(fields: [catalogoId], references: [id])

  @@unique([listaId, catalogoId])
  @@map("items_lista_compras")
}

// ---------------------------------------------------------------------------
// 16-banco-fotos.md
// ---------------------------------------------------------------------------

enum FuenteFoto {
  web
  subida

  @@map("fuente_foto")
}

enum EstadoFoto {
  pendiente
  aprobada
  rechazada

  @@map("estado_foto")
}

model FotoBanco {
  id            String     @id @default(uuid())
  url           String
  fuente        FuenteFoto
  estado        EstadoFoto @default(pendiente)
  etiquetas     String[]   @default([])
  titulo        String?
  autor         String?
  licencia      String?
  origenUrl     String?    @unique @map("origen_url")
  subidaPorId   String?    @map("subida_por_id")
  revisadaPorId String?    @map("revisada_por_id")
  creadaEn      DateTime   @default(now()) @map("creada_en")
  revisadaEn    DateTime?  @map("revisada_en")

  subidaPor   Usuario? @relation("FotosSubidas", fields: [subidaPorId], references: [id], onDelete: SetNull)
  revisadaPor Usuario? @relation("FotosRevisadas", fields: [revisadaPorId], references: [id], onDelete: SetNull)

  @@index([estado, fuente])
  @@index([etiquetas], type: Gin)
  @@map("fotos_banco")
}

// ---------------------------------------------------------------------------
// 01-auth.md — código temporal para compartir (venta de mostrador)
// ---------------------------------------------------------------------------

model CodigoCliente {
  id        String   @id @default(uuid())
  codigo    String   @unique @db.Char(6)
  usuarioId String   @map("usuario_id")
  expiraEn  DateTime @map("expira_en")
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("codigos_cliente")
}

// ---------------------------------------------------------------------------
// 23-puntos-pagos.md — renovación del plan y órdenes de pago en pesos
// ---------------------------------------------------------------------------

enum RenovacionAuto {
  ninguna
  puntos
  pesos

  @@map("renovacion_auto")
}

enum ConceptoPago {
  premium
  publicidad

  @@map("concepto_pago")
}

enum EstadoOrdenPago {
  pendiente
  pagada
  cancelada
  vencida

  @@map("estado_orden_pago")
}

model OrdenPago {
  id             String          @id @default(uuid())
  usuarioId      String          @map("usuario_id")
  concepto       ConceptoPago
  referenciaId   String?         @map("referencia_id")
  montoArs       Decimal         @map("monto_ars") @db.Decimal(12, 2)
  estado         EstadoOrdenPago @default(pendiente)
  proveedor      String          @default("manual")
  externalId     String?         @map("external_id")
  detalle        Json?
  creadaEn       DateTime        @default(now()) @map("creada_en")
  pagadaEn       DateTime?       @map("pagada_en")
  confirmadaPor  String?         @map("confirmada_por")

  usuario     Usuario         @relation("OrdenesDelUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  confirmador Usuario?        @relation("OrdenesConfirmadas", fields: [confirmadaPor], references: [id], onDelete: SetNull)
  campanias   CampaniaAviso[]

  @@index([estado, creadaEn(sort: Desc)])
  @@index([usuarioId])
  @@map("ordenes_pago")
}

// ---------------------------------------------------------------------------
// 21-publicidad.md — motor de avisos propio
// ---------------------------------------------------------------------------

enum EspacioAviso {
  inicio
  lista
  comparar
  tienda_pie
  pin_mapa
  push

  @@map("espacio_aviso")
}

enum EstadoCampania {
  pendiente_pago
  en_moderacion
  activa
  pausada
  rechazada
  finalizada

  @@map("estado_campania")
}

enum PagoCampania {
  puntos
  pesos

  @@map("pago_campania")
}

enum TipoPieza {
  imagen
  texto

  @@map("tipo_pieza")
}

enum TipoEventoAviso {
  impresion
  clic

  @@map("tipo_evento_aviso")
}

model CampaniaAviso {
  id                 String         @id @default(uuid())
  tiendaId           String         @map("tienda_id")
  creadaPorId        String?        @map("creada_por_id")
  espacio            EspacioAviso
  titulo             String
  estado             EstadoCampania
  desde              DateTime       @db.Date
  dias               Int
  diasConsumidos     Int            @default(0) @map("dias_consumidos")
  ultimoDiaConsumido DateTime?      @map("ultimo_dia_consumido") @db.Date
  pago               PagoCampania
  puntosPagados      Decimal?       @map("puntos_pagados") @db.Decimal(8, 1)
  ordenPagoId        String?        @map("orden_pago_id")
  segmento           Json?
  peso               Int            @default(1)
  motivoRechazo      String?        @map("motivo_rechazo")
  enviadaEn          DateTime?      @map("enviada_en")
  creadaEn           DateTime       @default(now()) @map("creada_en")
  aprobadaEn         DateTime?      @map("aprobada_en")
  finalizadaEn       DateTime?      @map("finalizada_en")

  tienda    Tienda        @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  creadaPor Usuario?      @relation(fields: [creadaPorId], references: [id], onDelete: SetNull)
  ordenPago OrdenPago?    @relation(fields: [ordenPagoId], references: [id], onDelete: SetNull)
  piezas    PiezaAviso[]
  eventos   EventoAviso[]

  @@index([espacio, estado])
  @@index([tiendaId])
  @@map("campanias_aviso")
}

model PiezaAviso {
  id         String    @id @default(uuid())
  campaniaId String    @map("campania_id")
  tipo       TipoPieza
  imagenUrl  String?   @map("imagen_url")
  ancho      Int?
  alto       Int?
  texto      String?
  destino    String?
  creadaEn   DateTime  @default(now()) @map("creada_en")

  campania CampaniaAviso @relation(fields: [campaniaId], references: [id], onDelete: Cascade)
  eventos  EventoAviso[]

  @@map("piezas_aviso")
}

model EventoAviso {
  id         String          @id @default(uuid())
  campaniaId String          @map("campania_id")
  piezaId    String?         @map("pieza_id")
  tipo       TipoEventoAviso
  usuarioId  String?         @map("usuario_id")
  nonce      String
  creadoEn   DateTime        @default(now()) @map("creado_en")

  campania CampaniaAviso @relation(fields: [campaniaId], references: [id], onDelete: Cascade)
  pieza    PiezaAviso?   @relation(fields: [piezaId], references: [id], onDelete: SetNull)
  usuario  Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@unique([tipo, nonce])
  @@index([campaniaId, tipo, creadoEn])
  @@index([usuarioId, creadoEn])
  @@map("eventos_aviso")
}

// ---------------------------------------------------------------------------
// 22-notificaciones.md
// ---------------------------------------------------------------------------

enum EstadoEnvio {
  enviando
  enviado
  cancelado

  @@map("estado_envio")
}

model Notificacion {
  id         String    @id @default(uuid())
  usuarioId  String    @map("usuario_id")
  tipo       String
  titulo     String
  cuerpo     String
  url        String?
  tiendaId   String?   @map("tienda_id")
  claveUnica String?   @unique @map("clave_unica")
  enApp      Boolean   @default(true) @map("en_app")
  leidaEn    DateTime? @map("leida_en")
  creadaEn   DateTime  @default(now()) @map("creada_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tienda  Tienda? @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([usuarioId, creadaEn(sort: Desc)])
  @@index([usuarioId, tipo, creadaEn])
  @@map("notificaciones")
}

model SuscripcionPush {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  creadaEn  DateTime @default(now()) @map("creada_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("suscripciones_push")
}

model PreferenciaNotificacion {
  usuarioId String  @map("usuario_id")
  categoria String
  enApp     Boolean @map("en_app")
  push      Boolean
  email     Boolean

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, categoria])
  @@map("preferencias_notificacion")
}

model EnvioNotificacion {
  id              String      @id @default(uuid())
  categoria       String
  tipo            String
  titulo          String
  cuerpo          String
  url             String?
  segmento        Json
  estado          EstadoEnvio @default(enviando)
  total           Int
  enviados        Int         @default(0)
  ultimoUsuarioId String?     @map("ultimo_usuario_id")
  creadoPorId     String?     @map("creado_por_id")
  creadoEn        DateTime    @default(now()) @map("creado_en")
  terminadoEn     DateTime?   @map("terminado_en")

  creadoPor Usuario? @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@map("envios_notificacion")
}
