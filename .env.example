# Base de datos (PostgreSQL + PostGIS). En local: infra/docker-compose.yml, servicio
# postgres (credenciales almacenia/almacenia, ver ahí).
DATABASE_URL=postgresql://almacenia:almacenia@localhost:5432/almacenia?schema=public

# Auth
AUTH_SECRET=

# CORS / dominio propio del deploy (si se expone API a otros orígenes)
ALLOWED_ORIGIN=http://localhost:3000

# Mapa (si se usa un proveedor de tiles con API key)
MAP_TILES_API_KEY=

# S3-compatible para fotos (08-archivos.md). En local: docker-compose.yml (raíz),
# servicio s3mock. En Coolify: MinIO autoalojado o un proveedor S3 real — ver
# docs/deploy-coolify.md.
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Permia: tema por rubro de esta instalación (specs/sdd/21-temas.md). Se leen en
# runtime: cambiar el valor y reiniciar el contenedor alcanza, sin rebuild.
# Rubros: almacen | bebidas | vinos | vivero
PERMIA_RUBRO=almacen
# Opcionales: si quedan vacíos se usan los textos del tema.
PERMIA_NOMBRE=
PERMIA_ESLOGAN=
PERMIA_DESCRIPCION=
